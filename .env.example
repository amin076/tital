# Google Cloud & Vertex AI Configuration for Tital
# ------------------------------------------------

GOOGLE_CLOUD_PROJECT=scientific-film-director-agent
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Agent model
# -----------
# Tital's submission runtime model is code-owned in src/config/models.ts and is
# currently gemini-3.5-flash. It is intentionally not overridden with an env var
# so deployed hackathon evidence cannot silently drift to an older model.

# Local API / web development overrides
# -------------------------------------
TITAL_API_HOST=127.0.0.1
TITAL_API_PORT=8787
TITAL_WEB_ORIGIN=http://127.0.0.1:5173

# Optional path to a pre-built Vite application.
# TITAL_WEB_DIST_DIR=C:\path\to\tital\apps\web\dist

# Optional local session directory.
# TITAL_SESSION_DIR=C:\path\to\tital\.tital\sessions

# Optional bounded external-call concurrency (clamped to 1..8).
# TITAL_EXTERNAL_CONCURRENCY=3

# Durable Cloud Storage session persistence
# -----------------------------------------
# TITAL_GCS_BUCKET=your-private-tital-session-bucket
# TITAL_GCS_PREFIX=sessions

# Public Tital authentication
# ---------------------------
# Keep authentication disabled for ordinary local development unless you want
# to exercise the full sign-in flow. Public Cloud Run deployments should set
# TITAL_AUTH_REQUIRED=true and provide Firebase / Identity Platform web config.
# The Firebase web API key is an application identifier, not a server secret;
# authorization is enforced by verified Firebase ID tokens on the backend.
# TITAL_AUTH_REQUIRED=true
# TITAL_FIREBASE_PROJECT_ID=scientific-film-director-agent
# TITAL_FIREBASE_API_KEY=your-firebase-web-api-key
# TITAL_FIREBASE_AUTH_DOMAIN=scientific-film-director-agent.firebaseapp.com

# Public read-only demo
# ---------------------
# The normal public snapshot ID is `public-demo`. Authenticated operators can
# publish a completed READY_FOR_PRODUCTION project into the detached base store
# using the Demo tools UI. TITAL_DEMO_SESSION_ID is only an optional override.
# TITAL_DEMO_SESSION_ID=public-demo

# Managed deployment note
# -----------------------
# Cloud Run provides PORT automatically. Do not hard-code PORT in the service
# configuration. When PORT is present, Tital defaults to 0.0.0.0 and serves the
# built React application and /api routes from the same Node process.
#
# On Cloud Run, use the service identity / Application Default Credentials.
# Do not upload a service-account key file and do not set
# GOOGLE_APPLICATION_CREDENTIALS to a bundled credential file.

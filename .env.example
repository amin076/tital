# Google Cloud & Vertex AI Configuration for Tital
# ------------------------------------------------

# The Google Cloud Project ID to use for Vertex AI APIs
GOOGLE_CLOUD_PROJECT=scientific-film-director-agent

# The location/region for Vertex AI API requests (e.g., global, us-central1)
GOOGLE_CLOUD_LOCATION=global

# Direct Google GenAI SDK to route requests through the Vertex AI API backend
GOOGLE_GENAI_USE_VERTEXAI=true

# Local API / web development overrides
# -------------------------------------
# These defaults are already built into the local server, so they normally do
# not need to be set. They are documented here for explicit local overrides.
TITAL_API_HOST=127.0.0.1
TITAL_API_PORT=8787
TITAL_WEB_ORIGIN=http://127.0.0.1:5173

# Optional path to a pre-built Vite application. The default is:
# apps/web/dist
# TITAL_WEB_DIST_DIR=C:\path\to\tital\apps\web\dist

# Managed deployment note
# -----------------------
# Cloud Run provides PORT automatically. Do not hard-code PORT in the service
# configuration. When PORT is present, Tital defaults to 0.0.0.0 and serves the
# built React application and /api routes from the same Node process.
